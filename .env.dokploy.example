# Paste into the Dokploy Compose Environment editor; replace blank secrets.
PUBLIC_HOSTNAME=intel.example.com
MCP_HOST_PORT=3002
# Provider configuration. No application accounts or login are used.
# Optional legacy encryption secret, not used for login.
JWT_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3005
ALLOWED_HOSTS=localhost,127.0.0.1,threat-intel-api
ENABLE_HSTS=false
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3005
MCP_HOST=127.0.0.1

# Local enterprise suffixes must be listed to avoid external disclosure.
# Comma-separated suffixes; defaults already block .local/.internal and reserved names.
INTERNAL_DOMAIN_SUFFIXES=

ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
ABUSECH_API_KEY=
# Set only after confirming your subscription/terms permit business use.
ABUSECH_COMMERCIAL_AUTHORIZED=false
ABUSECH_USAGE_MODE=personal
URLSCAN_API_KEY=
# Keep commercial for business use; choose personal only for your own non-business use.
VIRUSTOTAL_USAGE_MODE=personal
VIRUSTOTAL_QUOTA_DB=data/virustotal-personal-quota.sqlite3
VIRUSTOTAL_API_KEY=
# Requires licensed commercial/private VirusTotal access, never a public key.
VIRUSTOTAL_COMMERCIAL_AUTHORIZED=false

# Optional environment kill switches, e.g. PROVIDER_URLSCAN_ENABLED=false.
# Admin database settings cannot override an environment kill switch or licensing gate.

# Expansion: choose personal only for your own non-business use.
INTEL_USAGE_MODE=personal
IPINFO_TOKEN=
PULSEDIVE_API_KEY=
SPUR_TOKEN=
CENSYS_API_TOKEN=
CENSYS_ORG_ID=
CENSYS_SEARCH_AUTHORIZED=false
CLOUDFLARE_API_TOKEN=
# Radar IP context requires a token with access to the Radar IP endpoint.
# Enable URL Scanner separately only with the corresponding permissions.
PROVIDER_CLOUDFLARE_URLSCANNER_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
SHODAN_COMMERCIAL_AUTHORIZED=false
PROVIDER_DNS_DOH_ENABLED=false
NVD_API_KEY=
# This setting attests that you have reviewed and accepted OpenPhish feed terms.
OPENPHISH_TERMS_ACCEPTED=false
FEED_POLL_SECONDS=3600
INTEL_STATE_DB=data/state/intelligence.sqlite3
INTEL_PERSIST_CACHE=false
# Fernet key; if blank, protected storage derives a key from the strong JWT secret.
INTEL_STORAGE_KEY=
ENABLE_IDENTITY_LOOKUPS=false
HIBP_API_KEY=
HUDSONROCK_API_KEY=
# Passive search deployment: submissions are disabled.
ENABLE_SUBMISSIONS=false
MCP_TRANSPORT=http
# For personal local MCP without login/expiry, use none and bind MCP_HOST=127.0.0.1.
MCP_AUTH_MODE=none


# Optional authenticated Shodan host API; separate from keyless InternetDB.
SHODAN_API_KEY=
